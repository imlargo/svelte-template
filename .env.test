# Pinned for the test run so a developer's local .env cannot decide what the
# suite proves. With PUBLIC_AUTH_ENABLED=false the auth hook is swapped for a
# no-op and every authorization test would pass without asserting anything.
PUBLIC_AUTH_ENABLED=true
# Required by the env schema in src/env.ts. Never contacted: tests mock the
# services that would call it.
PUBLIC_API_URL=http://api.test
