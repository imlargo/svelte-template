# ─── App ──────────────────────────────────────────────────────────────────────
PUBLIC_API_URL=http://localhost:8000
# Only when auth lives on its own host; empty falls back to PUBLIC_API_URL.
PUBLIC_AUTH_BASE_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
PUBLIC_AUTH_ENABLED=true

# Auth methods — enable the strategies your backend supports
PUBLIC_AUTH_PASSWORD_ENABLED=true
PUBLIC_AUTH_GOOGLE_ENABLED=false
PUBLIC_GOOGLE_CLIENT_ID=

# Renew an expired access token with the refresh token. Only turn it on if the
# backend implements POST /auth/refresh (see features/auth/services/auth.ts).
PUBLIC_AUTH_REFRESH_ENABLED=false

# ─── Auth cookies (server-only) ───────────────────────────────────────────────
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE=604800
AUTH_COOKIE_SAMESITE=lax
